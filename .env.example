# Copy to .env and adjust. docker compose reads .env automatically.
POSTGRES_USER=yeet
POSTGRES_PASSWORD=yeet
POSTGRES_DB=yeet

# Auth: "stytch" (real sign-in) or "dev" (no login; anyone can act as anyone).
# Dev only runs with APP_ENV=local, and Docker only listens on 127.0.0.1.
APP_ENV=local
AUTH_MODE=stytch
# From the Stytch dashboard (B2B project). Neither is secret; never put the Stytch *secret* here.
STYTCH_PROJECT_ID=
STYTCH_PUBLIC_TOKEN=
STYTCH_ENV=test
# Sign-in length in minutes. Can't exceed the max session duration in Stytch's SDK configuration.
STYTCH_SESSION_MINUTES=60
